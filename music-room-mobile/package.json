  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "dev:ios": "node --env-file-if-exists=.env scripts/check-native-config.cjs ios && expo run:ios",
    "dev:android": "node --env-file-if-exists=.env scripts/check-native-config.cjs android && expo run:android",
    "start:dev": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "export:native": "expo export --platform all",
    "eas-build-pre-install": "if [ -n \"$ENV_FILE\" ]; then cp \"$ENV_FILE\" .env; fi"
  },
  "private": true
}
