# Public browser configuration only; never add JWT secrets or OAuth client secrets.
VITE_API_URL=http://localhost:3000
# How long a song lasts in the rooms, in seconds (30 = the length of the extracts). Empty: each song keeps its real length.
VITE_SONG_SECONDS=30

# Public Web OAuth client ID (same audience accepted by the backend).
VITE_GOOGLE_CLIENT_ID=
